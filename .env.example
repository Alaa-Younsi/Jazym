# Copy to .env and fill in — NEVER commit .env
# Supabase project settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Production site URL (used by SEO tags, sitemap, link-preview middleware).
# Apex domain, https, no trailing slash. www.jazym.shop redirects here (vercel.json).
VITE_SITE_URL=https://jazym.shop

# Optional: Google Analytics 4 measurement id (leave blank to disable)
VITE_GA_MEASUREMENT_ID=
