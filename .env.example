# Copy to .env and fill in — NEVER commit .env
# Supabase project settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Production site URL (used by SEO tags, sitemap, link-preview middleware).
# Keep in sync with SITE_URL in src/lib/seo.ts, middleware.ts, scripts/generate-sitemap.mjs.
VITE_SITE_URL=https://PLACEHOLDER-DOMAIN.tld

# Optional: Google Analytics 4 measurement id (leave blank to disable)
VITE_GA_MEASUREMENT_ID=
